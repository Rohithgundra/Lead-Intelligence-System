# Lead Intelligence System - Environment Configuration Example

# Choose your preferred LLM Provider: "gemini", "groq", "openai", or "rule-based"
LLM_PROVIDER=auto

# Google Gemini API Key (Recommended free tier)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Free tier available)
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Pipeline Settings
BATCH_SIZE=5
DEFAULT_REFERENCE_DATE=auto
